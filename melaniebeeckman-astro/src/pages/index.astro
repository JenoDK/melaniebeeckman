---
/* The root sends visitors to their language: English browsers get /en/, everyone else /nl/. */
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <title>Melanie Beeckman</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://melaniebeeckman.be/nl/" />
    <meta http-equiv="refresh" content="0; url=/nl/" />
    <script is:inline>
      (function () {
        var l = (navigator.languages && navigator.languages[0]) || navigator.language || 'nl';
        l = l.slice(0, 2).toLowerCase();
        location.replace('/' + (l === 'en' ? 'en' : 'nl') + '/');
      })();
    </script>
  </head>
  <body style="background: #F7F0E8;">
    <a href="/nl/">Melanie Beeckman</a>
  </body>
</html>
