---
import Layout from '@layouts/Layout.astro';
import BreathingBlob from '@components/BreathingBlob.astro';
import SessionsApp from '@components/SessionsApp.astro';
import SessionsStatus from '@components/SessionsStatus.astro';
import { t, langPaths, type Lang } from '@i18n/index';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const c = t(lang);
const s = c.sessions;
---

<Layout lang={lang} page="sessions">
  <section class="wrap row" style="padding-top: 64px; padding-bottom: 64px; gap: clamp(40px, 7vw, 96px);">
    <div class="stack" style="flex: 1 1 460px; gap: 22px;">
      <p class="eyebrow e-rise">{s.eyebrow}</p>
      <h1 class="h1 e-rise e-d1">{s.titleA}<em>{s.titleB}</em></h1>
      <p class="lead e-rise e-d2">{s.intro}</p>
      <SessionsStatus lang={lang} pill />
    </div>
    <div class="e-rise e-d1" style="margin: 0 auto;">
      <BreathingBlob size="min(260px, 60vw)" halo={false} />
    </div>
  </section>

  <SessionsApp lang={lang} />

  <section class="band">
    <div class="wrap grid reveal" style="--min: 280px; --gap: 48px; padding-top: 100px; padding-bottom: 100px;">
      <div class="stack" style="gap: 16px;">
        <h2 class="h2" style="font-size: 40px;">{s.infoTitle}</h2>
        <p class="body">{c.services.mindText}</p>
      </div>
      <ul class="dots ruled body">{s.info.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>
</Layout>
