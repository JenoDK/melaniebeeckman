---
import Layout from '@layouts/Layout.astro';
import BreathingBlob from '@components/BreathingBlob.astro';
import { t, href, langPaths, type Lang } from '@i18n/index';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const c = t(lang);
---

<Layout lang={lang} page="notFound">
  <section class="wrap stack center" style="padding-top: 48px; padding-bottom: 140px; gap: 28px;">
    <BreathingBlob size="min(220px, 56vw)" halo={false} />
    <h1 class="h2">{c.notFound.title}</h1>
    <p class="lead">{c.notFound.text}</p>
    <a class="btn" href={href(lang, 'home')}>{c.notFound.cta}</a>
  </section>
</Layout>
