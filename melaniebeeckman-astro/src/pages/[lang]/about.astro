---
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import portrait from '@assets/melanie.jpg';
import { t, href, langPaths, type Lang } from '@i18n/index';
import { site } from '@lib/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const c = t(lang);
const a = c.about;
---

<Layout lang={lang} page="about">
  <section class="wrap row" style="padding-top: 64px; padding-bottom: 140px; gap: clamp(48px, 8vw, 110px);">
    <div class="stack" style="flex: 1 1 380px; gap: 24px;">
      <p class="eyebrow e-rise">{a.eyebrow}</p>
      <h1 class="h1 e-rise e-d1">{a.title}</h1>
      <p class="lead e-rise e-d2">{a.bio}</p>
      <blockquote class="quote e-rise e-d3" style="margin-top: 8px; font-size: 28px; line-height: 1.35; font-weight: 400; max-width: 22em;">{a.quote}</blockquote>
    </div>
    <div class="blob e-rise e-d1" style="width: min(380px, 80vw); aspect-ratio: 4 / 5;">
      <div class="e-soft" aria-hidden="true" style="inset: -24px -24px -24px 24px;"><div class="e-morph fill" style="background: var(--pink-2);"></div></div>
      <Image src={portrait} alt="Melanie Beeckman" width={512} height={512} loading="eager" class="portrait" style="border-radius: 999px 999px 40px 40px;" />
    </div>
  </section>

  <section class="band">
    <div class="wrap stack reveal" style="padding-top: 120px; padding-bottom: 120px; gap: 48px;">
      <div class="stack" style="gap: 12px;">
        <h2 class="h2">{a.specTitle}</h2>
        <p class="body body-lg">{a.specIntro}</p>
      </div>
      <div class="grid" style="--min: 240px; --gap: 20px;">
        {
          c.specialties.map((s) => (
            <article class="card-lift stack" style="background: var(--page); border-radius: 28px; padding: 32px; gap: 14px;">
              <div aria-hidden="true" style="width: 40px; height: 40px; border-radius: 46% 54% 50% 50% / 52% 48% 52% 48%; background: var(--pink-2);" />
              <h3 style="margin: 0; font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1.15; color: var(--wine);">{s.title}</h3>
              <p class="body" style="font-size: 15px;">{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap grid reveal" style="--min: 300px; --gap: 64px; padding-top: 120px; padding-bottom: 120px;">
    <div class="stack" style="gap: 28px;">
      <h2 class="h2" style="font-size: 40px;">{a.eduTitle}</h2>
      <ul class="stack" style="list-style: none; margin: 0; padding: 0;">
        {
          c.edu.map((e) => (
            <li style="display: flex; gap: 24px; padding: 20px 0; border-top: 1px solid var(--line);">
              <span style="flex: 0 0 96px; font-size: 14px; color: var(--ink-3); padding-top: 2px;">{e.year}</span>
              <span class="body">{e.text}</span>
            </li>
          ))
        }
        <li style="display: flex; gap: 24px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
          <span style="flex: 0 0 96px; font-size: 14px; color: var(--ink-3); padding-top: 2px;">{a.riziv}</span>
          <span class="body">{site.riziv}</span>
        </li>
      </ul>
    </div>
    <div class="stack" style="gap: 28px;">
      <h2 class="h2" style="font-size: 40px;">{a.pubTitle}</h2>
      <p class="body empty" style="text-align: left; border-radius: 20px; padding: 24px;">{a.pubText}</p>
      <div class="row" style="gap: 12px; margin-top: 12px;">
        <a class="btn" href={site.rosa} target="_blank" rel="noopener">{a.cta}</a>
        <a class="btn btn-line" href={href(lang, 'services')}>{c.nav.services}</a>
      </div>
    </div>
  </section>
</Layout>
