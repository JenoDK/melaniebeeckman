---
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import BreathingBlob from '@components/BreathingBlob.astro';
import FaqList from '@components/FaqList.astro';
import SessionsStatus from '@components/SessionsStatus.astro';
import Wave from '@components/Wave.astro';
import portrait from '@assets/melanie.jpg';
import { t, href, langPaths, type Lang } from '@i18n/index';
import { site } from '@lib/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const c = t(lang);
const h = c.home;
const homeFaq = [c.faq.groups[0].items[0], c.faq.groups[1].items[0], c.faq.groups[1].items[1]];
---

<Layout lang={lang} page="home">
  <section class="wrap row" style="padding-top: 64px; padding-bottom: 150px; gap: clamp(48px, 8vw, 110px);">
    <div class="blob e-rise" style="width: min(340px, 78vw); aspect-ratio: 1;">
      <div class="e-soft" aria-hidden="true" style="inset: -22px;"><div class="e-morph fill" style="background: var(--pink-2);"></div></div>
      <div class="e-turnback" aria-hidden="true" style="inset: -40px;"><div class="e-morph fill" style="border: 1px solid var(--tan); animation-delay: -9s;"></div></div>
      <Image src={portrait} alt="Melanie Beeckman" width={512} height={512} loading="eager" fetchpriority="high" class="portrait" style="border-radius: 49% 51% 52% 48% / 50% 48% 52% 50%;" />
    </div>
    <div class="stack" style="flex: 1 1 380px; gap: 24px;">
      <p class="eyebrow e-rise">{h.eyebrow}</p>
      <h1 class="h1 e-rise e-d1">{h.h1a}<em>{h.h1b}</em></h1>
      <p class="lead e-rise e-d2">{h.intro}</p>
      <div class="row e-rise e-d3" style="gap: 24px; margin-top: 8px;">
        <a class="btn" href={site.rosa} target="_blank" rel="noopener">{h.cta1}</a>
        <a class="tlink" href={href(lang, 'about')}>{h.cta2}</a>
      </div>
      <p class="small e-rise e-d3">{h.elpA}<a href={site.elp} target="_blank" rel="noopener">{h.elpLink}</a>{h.elpB}</p>
    </div>
  </section>

  <section class="wrap stack reveal" style="padding-bottom: 120px; gap: 40px;">
    <div class="stack center" style="gap: 12px;">
      <Wave />
      <h2 class="h2">{h.helpTitle}</h2>
    </div>
    <article class="card card-lift row" style="gap: 36px;">
      <div class="icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6B1E2E" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg>
      </div>
      <div class="stack" style="flex: 1 1 320px; gap: 12px;">
        <h3 class="h3">{h.therapyTitle}</h3>
        <p class="body body-lg" style="max-width: 36em;">{h.therapyText}</p>
      </div>
      <a class="arrow-link" href={href(lang, 'services')}>{h.readMore} →</a>
    </article>
  </section>

  <section class="band">
    <div class="wrap row reveal" style="padding-top: 140px; padding-bottom: 140px; gap: clamp(56px, 8vw, 120px);">
      <BreathingBlob breatheIn={h.breatheIn} breatheOut={h.breatheOut} />
      <div class="stack" style="flex: 1 1 340px; gap: 22px;">
        <p class="eyebrow">{h.mindEyebrow}</p>
        <h2 class="h2" style="font-size: clamp(38px, 4.4vw, 56px);">{h.mindA}<em>{h.mindB}</em></h2>
        <p class="body body-lg" style="max-width: 30em;">{h.mindText}</p>
        <SessionsStatus lang={lang} />
        <a class="btn" href={href(lang, 'sessions')} style="align-self: flex-start;">{h.mindCta}</a>
      </div>
    </div>
  </section>

  <section class="stack center reveal" style="max-width: 900px; margin: 0 auto; padding: 150px 24px; gap: 28px;">
    <svg width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="#B9957F" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M22 40V10"></path><path d="M22 30c-8-1-13-6-14-14 8 1 13 6 14 14z"></path><path d="M22 22c8-1 13-6 14-14-8 1-13 6-14 14z"></path></svg>
    <blockquote class="quote" style="font-size: clamp(30px, 3.8vw, 50px);">{h.quote}</blockquote>
  </section>

  <section class="wrap reveal" style="padding-bottom: 140px;">
    <div class="card card-sand row" style="justify-content: space-between; gap: 32px;">
      <div class="stack" style="flex: 1 1 380px; gap: 14px;">
        <p class="eyebrow">{h.groupsEyebrow}</p>
        <h2 class="h2" style="font-size: clamp(32px, 3.4vw, 42px);">{h.groupsTitle}</h2>
        <p class="body" style="max-width: 34em;">{h.groupsText}</p>
      </div>
      <div class="row" style="gap: 12px;">
        <a class="btn" href={href(lang, 'orgs') + '?type=group#aanvraag'}>{c.shared.bookGroup}</a>
        <a class="btn btn-soft" href={href(lang, 'orgs') + '?type=talk#aanvraag'}>{c.shared.bookTalk}</a>
      </div>
    </div>
  </section>

  <section class="narrow stack reveal" style="max-width: 820px; padding-bottom: 150px; gap: 32px;">
    <h2 class="h2" style="text-align: center;">{h.faqTitle}</h2>
    <FaqList items={homeFaq} />
    <a class="tlink" href={href(lang, 'faq')} style="align-self: center;">{h.faqAll}</a>
  </section>
</Layout>
