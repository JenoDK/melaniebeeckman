---
interface Props {
  items: readonly { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((f) => (
      <details class="faq">
        <summary>
          {f.q}
          <span class="plus" aria-hidden="true">+</span>
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>
