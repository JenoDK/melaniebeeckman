HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Mail (booking confirmations + notifications to Melanie)
# Leave SMTP_HOST empty locally: mails are then only written to the Strapi log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Melanie Beeckman <noreply@melaniebeeckman.be>"
MAIL_REPLY_TO=psycholoog.melanie@gmail.com
NOTIFY_EMAIL=psycholoog.melanie@gmail.com

# Optional spam protection for the public forms (Cloudflare Turnstile secret key)
TURNSTILE_SECRET_KEY=
# Max confirmation emails to clients per day (UTC). Above this, bookings are still saved
# and Melanie is still notified, only the client mail is skipped. 0 = no limit.
CLIENT_MAIL_DAILY_LIMIT=40

# Websites allowed to call the booking API from the browser (comma separated).
CORS_ORIGINS=https://melaniebeeckman.be,https://www.melaniebeeckman.be
